@using FiveSafesTes.Core.Models.Enums
@using Data_Egress_UI.Helpers
@model FiveSafesTes.Core.Models.EgressSubmission

@{
    ViewData["Title"] = "Egress Request";


}

<div class="container-lg p-4">
    <div class="d-flex align-items-center justify-content-between">
        <h1 class="fs-3 mb-0"><span class="text-muted">Egress Request:</span> #@Model.EgressID() name @Model.Name</h1>
        <span>
            @Model.EgressStatusDisplay
        </span>
    </div>
    <hr class="d-flex my-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            @if (Model.Status != EgressStatus.NotCompleted)
            {
                <p class="text-muted fs-7 mt-4 mb-0">
                    Completed: @Model.Completed<span class="mx-2"></span>Reviewer: @Model.Reviewer
                </p>
            }
        </div>
    </div>
    @if (Model.IsFederated)
    {
        <div class="mt-4">
            <h2 class="fs-5">Study and approval <small class="text-muted">(as provided by the orchestrator)</small></h2>
            @if (Model.Study != null)
            {
                <p class="mb-1"><strong>Study:</strong> @Model.Study.Id</p>
            }
            @if (FederatedReviewFormatter.NothingProvided(Model.Study))
            {
                <p class="text-muted">Study details and data permit are not provided yet.</p>
            }
            else
            {
                <dl class="row">
                    @foreach (var (label, value) in FederatedReviewFormatter.StudyRows(Model.Study!))
                    {
                        <dt class="col-sm-3">@label</dt>
                        <dd class="col-sm-9">@value</dd>
                    }
                </dl>
            }
            <h2 class="fs-5 mt-4">Code</h2>
            <pre class="border p-2 bg-light">@Model.Code</pre>
            <h2 class="fs-5 mt-4">Result</h2>
            <pre class="border p-2 bg-light">@FederatedReviewFormatter.PrettyPrintJson(Model.ResultContent)</pre>
            <p class="text-muted">SHA-256: @Model.ResultSha256</p>
            @if (Model.TreClosedReason != null)
            {
                <div class="alert alert-danger">This request was closed by the TRE and cannot be decided: @Model.TreClosedReason</div>
            }
            else if (Model.Status != EgressStatus.NotCompleted && !Model.DecisionDelivered)
            {
                <div class="alert alert-warning">This decision is saved but has not reached the TRE yet. It is sent again automatically, and Complete &amp; Close sends it again now.</div>
            }
        </div>
    }
    @using (Html.BeginForm("GetEgress", "Data", FormMethod.Post, new { id = "frmMain" }))
    {
        @Html.HiddenFor(x => x.Id)
        @if (Model.IsFederated)
        {
            @Html.HiddenFor(x => x.Kind)
        }
        ;
        <div class="form-group mb-4">
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        </div>
        <ul class="list-group list-group-flush">
        @for (int i = 0; i < Model.Files.Count; i++)
        {
            
                <li class="list-group-item">
                    <div class="form-group">
                        @Html.HiddenFor(x => x.Files[i].Id)
                        @*@Html.LabelFor(x => x.Files[i].Name, new { @class = "form-label" })*@

                        <a href="@Url.Action("DownloadFile", "Data",new{FileId=@Model.Files[i].Id})" class="btn btn-link">@Html.DisplayFor(x => x.Files[i].Name, new { @class = "form-control" }) <i class="ms-2 fa fa-download"></i></a>
                   @* </div>*@
@*                    <div class="form-group">
*@                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(x => x.Files[i].Status, FileStatus.Approved, new { @class = "form-check-input"})
                            @Html.Label(FileStatus.Approved.ToString())
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(x => x.Files[i].Status, FileStatus.Rejected, new { @class = "form-check-input"})
                            @Html.Label(FileStatus.Rejected.ToString())
                        </div>
                        <div class="form-check form-check-inline">
                            @if (Model.Files[i].Status == FileStatus.Undecided)
                            {
                                @Html.RadioButtonFor(x => x.Files[i].Status, FileStatus.Undecided, new { @class = "form-check-input"})
                                @Html.Label(FileStatus.Undecided.ToString())
                            }
                        </div>
                    </div>
                </li>
            
            
        }
        </ul>
        @if (Model.IsFederated)
        {
            <div class="form-group mt-4">
                @Html.LabelFor(x => x.DecisionReason, "Reason (required to reject)", new { @class = "form-label" })
                @Html.TextAreaFor(x => x.DecisionReason, 3, 80, new { @class = "form-control" })
            </div>
        }
        <div class="mt-4">
            <button type="submit" name="submitButton" value="SubmitButton" class="btn btn-sm btn-primary">Complete &amp; Close Request</button>
            <button type="submit" name="submitButton" value="SaveButton" class=" btn btn-sm btn-primary">Save</button>

            
            <a class="btn btn-sm btn-link">Cancel</a>
        </div>
    }
</div>










