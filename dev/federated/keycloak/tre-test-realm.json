{
  "realm": "tre-test",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "data-egress-admin" }
    ]
  },
  "groups": [
    { "name": "dataset-upload", "path": "/dataset-upload" }
  ],
  "clients": [
    {
      "clientId": "rustfs-console",
      "enabled": true,
      "publicClient": false,
      "secret": "rustfs-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:9000/*", "http://localhost:9001/*"],
      "webOrigins": ["http://localhost:9000", "http://localhost:9001"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "Dare-TRE-API",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-dare-tre-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-dare-tre-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "Dare-TRE-API", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "uploader",
      "enabled": true,
      "emailVerified": true,
      "email": "uploader@example.org",
      "firstName": "Data",
      "lastName": "Uploader",
      "credentials": [{ "type": "password", "value": "uploader123", "temporary": false }],
      "groups": ["/dataset-upload"]
    },
    {
      "username": "egress-app",
      "enabled": true,
      "emailVerified": true,
      "email": "egress-app@example.local",
      "firstName": "Egress",
      "lastName": "App",
      "credentials": [{ "type": "password", "value": "EgressApp1!", "temporary": false }],
      "realmRoles": ["data-egress-admin"]
    }
  ]
}
